              Established in <strong className="text-brand-green">2020</strong>, Tazmeel Apparels is a Dhaka-based manufacturer of trendy, high-quality Islamic and modest clothing. We blend traditional and modern styles, delivering dependable apparel to a diverse client base.
            </p>

            {/* ⭐ Highlight Chips — Ultra Responsive */}
            <div className="grid grid-cols-2 gap-1.5 xs:gap-2 sm:gap-3 mb-6">
              {highlights.map((h, i) => {
                const Icon = h.icon;
                return (
                  <motion.div
                    key={h.labelFull}
                    initial={{ opacity: 0, y: 15 }}
                    whileInView={{ opacity: 1, y: 0 }}
                    transition={{ duration: 0.4, delay: i * 0.08 }}
                    viewport={{ once: true }}
                    className="flex items-center gap-1.5 xs:gap-2 sm:gap-2.5 px-2 xs:px-2.5 sm:px-3 py-2 xs:py-2.5 bg-white border border-brand-gold/20 rounded-lg hover:border-brand-gold hover:shadow-md transition-all group min-w-0 w-full"
                  >
                    <div className="shrink-0 w-6 h-6 xs:w-7 xs:h-7 sm:w-8 sm:h-8 rounded-full bg-brand-gold/10 flex items-center justify-center group-hover:bg-brand-gold/20 transition-colors">
                      <Icon className="text-brand-gold" size={11} />
                    </div>
                    <span className="text-[9px] xs:text-[10px] sm:text-xs md:text-sm font-medium text-brand-dark leading-tight whitespace-nowrap overflow-hidden">
                      <span className="hidden xs:inline">{h.labelFull}</span>
                      <span className="xs:hidden">{h.labelShort}</span>
                    </span>
                  </motion.div>
                );
              })}
            </div>

            {/* Signature Quote */}
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              whileInView={{ opacity: 1, y: 0 }}
              transition={{ duration: 0.5, delay: 0.3 }}
              viewport={{ once: true }}
              className="relative pl-4 sm:pl-5 border-l-4 border-brand-gold bg-brand-gold/5 p-3.5 sm:p-5 rounded-r-lg"
            >
              <span className="absolute -top-3 left-3 text-3xl sm:text-4xl text-brand-gold/40 font-serif">"</span>
              <p className="text-xs sm:text-base text-brand-dark/80 italic mb-3 leading-relaxed">
                We don't just manufacture garments — we craft the confidence our clients wear.
              </p>
              <div className="flex items-center gap-3">
                <div className="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-brand-dark flex items-center justify-center shrink-0">
                  <span className="text-brand-gold font-serif text-xs sm:text-sm font-bold">T</span>
